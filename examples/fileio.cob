IDENTIFICATION DIVISION.
PROGRAM-ID. FILE-IO-DEMO.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT DATA-FILE ASSIGN TO '/tmp/cobol_demo.dat'
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-STATUS.
DATA DIVISION.
FILE SECTION.
FD DATA-FILE.
01 DATA-RECORD PIC X(30).
WORKING-STORAGE SECTION.
01 WS-STATUS  PIC XX VALUE SPACES.
01 WS-EOF     PIC 9(1) VALUE 0.
01 WS-COUNT   PIC 9(3) VALUE 0.
01 WS-READ-REC PIC X(30) VALUE SPACES.
PROCEDURE DIVISION.
    DISPLAY "Writing records...".
    OPEN OUTPUT DATA-FILE.
    MOVE 'Alice Johnson      Sales' TO DATA-RECORD.
    WRITE DATA-RECORD.
    MOVE 'Bob Smith          Engineering' TO DATA-RECORD.
    WRITE DATA-RECORD.
    MOVE 'Carol Davis        Marketing' TO DATA-RECORD.
    WRITE DATA-RECORD.
    CLOSE DATA-FILE.
    DISPLAY "Reading records back:".
    OPEN INPUT DATA-FILE.
    PERFORM UNTIL WS-EOF = 1
        READ DATA-FILE INTO WS-READ-REC
            AT END MOVE 1 TO WS-EOF
            NOT AT END
                ADD 1 TO WS-COUNT
                DISPLAY WS-COUNT ': ' WS-READ-REC
        END-READ
    END-PERFORM.
    CLOSE DATA-FILE.
    DISPLAY "Total records: " WS-COUNT.
    STOP RUN.
