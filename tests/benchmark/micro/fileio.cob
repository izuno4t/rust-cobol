       IDENTIFICATION DIVISION.
       PROGRAM-ID. BENCH-FILEIO.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT BENCH-FILE ASSIGN TO
               "bench_fileio.dat"
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD BENCH-FILE.
       01 BENCH-RECORD PIC X(80).
       WORKING-STORAGE SECTION.
       01 WS-STATUS     PIC XX.
       01 WS-COUNTER    PIC 9(9) VALUE 0.
       01 WS-ITERATIONS PIC 9(6) VALUE 10000.
       01 WS-DATA       PIC X(80) VALUE
           "BENCHMARK RECORD DATA FOR FILE IO TESTING".
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN OUTPUT BENCH-FILE.
           PERFORM WS-ITERATIONS TIMES
               WRITE BENCH-RECORD FROM WS-DATA
               COMPUTE WS-COUNTER = WS-COUNTER + 1
           END-PERFORM.
           CLOSE BENCH-FILE.
           DISPLAY "FILE I/O BENCHMARK".
           DISPLAY "WRITTEN: " WS-COUNTER.
           STOP RUN.
